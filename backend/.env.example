# Postgres connection (used by asyncpg pool)
DATABASE_URL=postgresql://aviation:aviation_dev_password@localhost:5432/aviation_gold

# LLM provider for the Text-to-SQL copilot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
COPILOT_MAX_ROWS=200
COPILOT_QUERY_TIMEOUT_SECONDS=10

# Path to Gold Parquet files, used only by the (not-yet-written) loader script
GOLD_PARQUET_PATH=/data/03_gold/

# CORS - comma separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001